# ==== source: vaultwarden ====
SRC_SERVER=https://vaultwarden.example.com
# vaultwarden web vault 左上帳號 → 設定 → API 金鑰
SRC_CLIENT_ID=
SRC_CLIENT_SECRET=
# 主密碼（解鎖用，非登入密碼）
SRC_MASTER=
# ==== target: bitwarden cloud ====
# 美國站 https://vault.bitwarden.com / 歐洲站 https://vault.bitwarden.eu (或 EU)
DST_SERVER=https://vault.bitwarden.com
# 建議也用 API 金鑰（bitwarden.com 網頁 → Account → API Key），可跳過裝置驗證
DST_CLIENT_ID=
DST_CLIENT_SECRET=
# 若不用 API key 才填这两個（新裝置登入可能被擋）：
DST_EMAIL=
DST_PASSWORD=
# bitwarden 端的主密碼
DST_MASTER=

# true = import 前先清空目標庫（DST 必須是專用備份帳號！）
